---
import Window from './Window.astro';
import enlaces from '../../data/enlaces.json';
import libros from '../../data/libros.json';
import musica from '../../data/musica.json';
import peliculas from '../../data/peliculas.json';
import quotes from '../../data/quotes.json';

const tabs = [
  { id: 'enlaces',   label: 'Enlaces',    count: enlaces.length },
  { id: 'libros',    label: 'Libros',     count: libros.length },
  { id: 'musica',    label: 'Música',     count: musica.length },
  { id: 'peliculas', label: 'Películas',  count: peliculas.length },
  { id: 'quotes',    label: 'Quotes',     count: quotes.length },
];
---
<Window slug="intereses" title="Intereses" x={280} y={100} width={640} height={520} z={100}>
  <div class="int">
    <div class="int-tabs">
      {tabs.map((t, i) => (
        <button
          type="button"
          data-int-tab={t.id}
          class:list={['int-tab', { 'is-active': i === 0 }]}
        >
          {t.label} <span class="mono int-tab-count">{t.count}</span>
        </button>
      ))}
    </div>

    <div class="int-panels">
      <div data-int-panel="enlaces" class="int-panel">
        {enlaces.length === 0 ? (
          <p class="int-empty">Aún nada por aquí.</p>
        ) : (
          <ul class="int-list">
            {enlaces.map((e: any) => (
              <li>
                <a href={e.url} target="_blank" rel="noopener" class="int-link">{e.title} ↗</a>
                {e.source && <span class="int-meta"> — {e.source}</span>}
                {e.note && <p class="int-note">{e.note}</p>}
              </li>
            ))}
          </ul>
        )}
      </div>

      <div data-int-panel="libros" class="int-panel" hidden>
        {libros.length === 0 ? (
          <p class="int-empty">Aún nada por aquí.</p>
        ) : (
          <ul class="int-list">
            {libros.map((l: any) => (
              <li class="int-book">
                <span class="int-badge">{l.status}</span>
                <div>
                  <div class="int-title">{l.title}</div>
                  <div class="int-meta">{l.author}</div>
                </div>
              </li>
            ))}
          </ul>
        )}
      </div>

      <div data-int-panel="musica" class="int-panel" hidden>
        {musica.length === 0 ? (
          <p class="int-empty">Aún nada por aquí.</p>
        ) : (
          <ul class="int-list">
            {musica.map((m: any) => (
              <li>
                <div class="int-title">{m.title}</div>
                <div class="int-meta">{m.artist} · {m.year}</div>
              </li>
            ))}
          </ul>
        )}
      </div>

      <div data-int-panel="peliculas" class="int-panel" hidden>
        {peliculas.length === 0 ? (
          <p class="int-empty">Aún nada por aquí.</p>
        ) : (
          <ul class="int-list">
            {peliculas.map((p: any) => (
              <li>
                <div class="int-title">{p.title}</div>
                <div class="int-meta">{p.director} · {p.year}</div>
              </li>
            ))}
          </ul>
        )}
      </div>

      <div data-int-panel="quotes" class="int-panel" hidden>
        {quotes.length === 0 ? (
          <p class="int-empty">Aún nada por aquí.</p>
        ) : (
          <ul class="int-list">
            {quotes.map((q: any) => (
              <li class="int-quote">
                <p class="int-quote-text">"{q.text}"</p>
                <p class="int-quote-author">— {q.author}{q.source && `, ${q.source}`}</p>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </div>
</Window>

<style is:global>
  [data-window="intereses"] .int { display: flex; flex-direction: column; height: 100%; }
  [data-window="intereses"] .int-tabs {
    display: flex; gap: 4px; padding: 8px 12px 0;
    border-bottom: 1px solid var(--color-border);
    flex-shrink: 0; overflow-x: auto;
  }
  [data-window="intereses"] .int-tab {
    padding: 8px 14px; border: none; background: transparent;
    font-size: 13px; font-weight: 500;
    color: var(--color-muted);
    border-bottom: 2px solid transparent;
    cursor: pointer; white-space: nowrap;
  }
  [data-window="intereses"] .int-tab.is-active {
    color: var(--color-ink);
    border-bottom-color: var(--color-indigo);
  }
  [data-window="intereses"] .int-tab-count {
    font-size: 10px; opacity: 0.6;
  }
  [data-window="intereses"] .int-panels { flex: 1; overflow-y: auto; }
  [data-window="intereses"] .int-panel { padding: 12px; }
  [data-window="intereses"] .int-empty {
    text-align: center; color: var(--color-muted);
    padding: 40px; font-size: 13px; margin: 0;
  }
  [data-window="intereses"] .int-list { list-style: none; padding: 0; margin: 0; }
  [data-window="intereses"] .int-list > li {
    padding: 12px; border-bottom: 1px solid var(--color-border);
  }
  [data-window="intereses"] .int-link {
    color: var(--color-indigo); font-weight: 500; font-size: 14px;
  }
  [data-window="intereses"] .int-meta {
    font-size: 12px; color: var(--color-muted);
  }
  [data-window="intereses"] .int-note {
    font-size: 12px; color: var(--color-muted); margin: 4px 0 0;
  }
  [data-window="intereses"] .int-title {
    font-weight: 500; font-size: 14px; color: var(--color-ink);
  }
  [data-window="intereses"] .int-book {
    display: flex; gap: 12px; align-items: baseline;
  }
  [data-window="intereses"] .int-badge {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px; padding: 2px 8px;
    background: var(--color-border); color: var(--color-muted);
    border-radius: 999px; text-transform: uppercase;
  }
  [data-window="intereses"] .int-quote {
    padding: 16px 12px !important;
  }
  [data-window="intereses"] .int-quote-text {
    font-size: 15px; font-style: italic;
    color: var(--color-ink);
    margin: 0; line-height: 1.55;
  }
  [data-window="intereses"] .int-quote-author {
    font-size: 12px; color: var(--color-muted); margin: 8px 0 0;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-window="intereses"]').forEach((win) => {
    const tabs = win.querySelectorAll<HTMLButtonElement>('[data-int-tab]');
    const panels = win.querySelectorAll<HTMLElement>('[data-int-panel]');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-int-tab');
        tabs.forEach((t) => t.classList.toggle('is-active', t === tab));
        panels.forEach((p) => {
          p.hidden = p.getAttribute('data-int-panel') !== target;
        });
      });
    });
  });
</script>
