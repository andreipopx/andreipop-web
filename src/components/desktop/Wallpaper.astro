---
/**
 * Wallpaper time-aware · un solo SVG parametrizado.
 * JS actualiza las variables CSS de --sky-top/--sky-bottom y la
 * posición del sol/luna según la hora local del visitante.
 * El toggle claro/oscuro solo afecta al chrome (menu bar / dock / ventanas).
 */
---
<div aria-hidden="true" style="position: fixed; inset: 0; z-index: -1; overflow: hidden;">
  <svg
    data-wallpaper
    viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice"
    style="width: 100%; height: 100%; display: block; position: absolute; inset: 0;"
  >
    <defs>
      <linearGradient id="sky-live" x1="0" y1="0" x2="0" y2="1">
        <stop data-sky-stop="top"    offset="0"    stop-color="#a5b4fc"/>
        <stop data-sky-stop="mid1"   offset="0.35" stop-color="#fbcfe8"/>
        <stop data-sky-stop="mid2"   offset="0.65" stop-color="#fed7aa"/>
        <stop data-sky-stop="bottom" offset="1"    stop-color="#fdba74"/>
      </linearGradient>
      <radialGradient id="sunglow-live" cx="0.7" cy="0.65" r="0.35">
        <stop offset="0" stop-color="#fef3c7" stop-opacity="0.7"/>
        <stop offset="1" stop-color="#fef3c7" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="1600" height="1000" fill="url(#sky-live)"/>
    <rect data-glow width="1600" height="1000" fill="url(#sunglow-live)"/>

    <!-- Astro (sol o luna) — JS mueve cx/cy y cambia fill -->
    <circle data-astro-outer cx="1120" cy="620" r="80" fill="#fbbf24" opacity="0.25"/>
    <circle data-astro       cx="1120" cy="620" r="55" fill="#fbbf24" opacity="0.9"/>

    <!-- Estrellas (visibles solo en fase oscura, JS toggle opacity) -->
    <g data-stars fill="#e0e7ff" opacity="0">
      <circle cx="180" cy="130" r="1.2"/>
      <circle cx="320" cy="80"  r="0.8"/>
      <circle cx="450" cy="200" r="1"/>
      <circle cx="600" cy="90"  r="0.9"/>
      <circle cx="780" cy="180" r="1.4"/>
      <circle cx="900" cy="60"  r="0.7"/>
      <circle cx="1050" cy="140" r="1"/>
      <circle cx="1250" cy="90" r="0.9"/>
      <circle cx="1400" cy="180" r="1.2"/>
      <circle cx="1520" cy="120" r="0.8"/>
      <circle cx="80"   cy="260" r="0.9"/>
      <circle cx="250"  cy="320" r="1.1"/>
      <circle cx="530"  cy="380" r="0.7"/>
      <circle cx="1180" cy="340" r="1"/>
      <circle cx="1330" cy="290" r="0.8"/>
    </g>

    <!-- Cráteres de luna (visibles solo cuando el astro es luna, JS toggle) -->
    <g data-moon-craters opacity="0">
      <circle data-crater-1 cx="1135" cy="608" r="6" fill="#cbd5e1"/>
      <circle data-crater-2 cx="1105" cy="636" r="4" fill="#cbd5e1"/>
      <circle data-crater-3 cx="1140" cy="640" r="3" fill="#cbd5e1"/>
    </g>

    <!-- Mountains -->
    <path data-mountain-back  d="M0 700 L200 620 L400 680 L700 580 L900 640 L1200 600 L1600 660 L1600 1000 L0 1000 Z" fill="#7c3aed" opacity="0.3"/>
    <path data-mountain-mid   d="M0 780 L150 720 L350 770 L600 700 L850 750 L1100 720 L1400 760 L1600 730 L1600 1000 L0 1000 Z" fill="#5b21b6" opacity="0.5"/>
    <path data-mountain-front d="M0 870 L200 830 L500 860 L800 820 L1100 850 L1400 830 L1600 850 L1600 1000 L0 1000 Z" fill="#1e1b4b" opacity="0.75"/>
  </svg>

  <svg style="position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0.4; mix-blend-mode: overlay;" preserveAspectRatio="none">
    <filter id="grain-wp"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="7"/><feColorMatrix values="0 0 0 0 0.5  0 0 0 0 0.5  0 0 0 0 0.5  0 0 0 0.5 0"/></filter>
    <rect width="100%" height="100%" filter="url(#grain-wp)"/>
  </svg>
</div>
