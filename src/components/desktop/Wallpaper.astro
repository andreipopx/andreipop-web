---
/**
 * Wallpaper Big Sur · curvas fluidas + trees + birds animados.
 * El cielo y el sol/luna siguen siendo time-aware (desktop.ts los pinta).
 * Los waves y los árboles son fijos (solo se tintan según theme).
 */
---
<div aria-hidden="true" class="wallpaper-root">
  <svg
    data-wallpaper
    viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice"
    class="wallpaper-svg"
  >
    <defs>
      <linearGradient id="sky-live" x1="0" y1="0" x2="0" y2="1">
        <stop data-sky-stop="top"    offset="0"    stop-color="#a5b4fc"/>
        <stop data-sky-stop="mid1"   offset="0.35" stop-color="#fbcfe8"/>
        <stop data-sky-stop="mid2"   offset="0.65" stop-color="#fed7aa"/>
        <stop data-sky-stop="bottom" offset="1"    stop-color="#fdba74"/>
      </linearGradient>
      <radialGradient id="sunglow-live" cx="0.7" cy="0.65" r="0.35">
        <stop offset="0" stop-color="#fef3c7" stop-opacity="0.7"/>
        <stop offset="1" stop-color="#fef3c7" stop-opacity="0"/>
      </radialGradient>

      <!-- Wave gradients (Big Sur palette) -->
      <linearGradient id="wave-1" x1="0" y1="0" x2="0" y2="1">
        <stop data-wave-stop="1a" offset="0" stop-color="#8b5cf6"/>
        <stop data-wave-stop="1b" offset="1" stop-color="#5b21b6"/>
      </linearGradient>
      <linearGradient id="wave-2" x1="0" y1="0" x2="0" y2="1">
        <stop data-wave-stop="2a" offset="0" stop-color="#ec4899"/>
        <stop data-wave-stop="2b" offset="1" stop-color="#be185d"/>
      </linearGradient>
      <linearGradient id="wave-3" x1="0" y1="0" x2="0" y2="1">
        <stop data-wave-stop="3a" offset="0" stop-color="#f97316"/>
        <stop data-wave-stop="3b" offset="1" stop-color="#c2410c"/>
      </linearGradient>
    </defs>

    <rect width="1600" height="1000" fill="url(#sky-live)"/>
    <rect data-glow width="1600" height="1000" fill="url(#sunglow-live)"/>

    <!-- Astro (sol o luna, JS pinta) -->
    <circle data-astro-outer cx="1120" cy="620" r="80" fill="#fbbf24" opacity="0.25"/>
    <circle data-astro       cx="1120" cy="620" r="55" fill="#fbbf24" opacity="0.9"/>

    <!-- Estrellas -->
    <g data-stars fill="#e0e7ff" opacity="0">
      <circle cx="180" cy="130" r="1.2"/><circle cx="320" cy="80"  r="0.8"/>
      <circle cx="450" cy="200" r="1"/><circle cx="600" cy="90"  r="0.9"/>
      <circle cx="780" cy="180" r="1.4"/><circle cx="900" cy="60"  r="0.7"/>
      <circle cx="1050" cy="140" r="1"/><circle cx="1250" cy="90" r="0.9"/>
      <circle cx="1400" cy="180" r="1.2"/><circle cx="1520" cy="120" r="0.8"/>
      <circle cx="80"   cy="260" r="0.9"/><circle cx="250"  cy="320" r="1.1"/>
      <circle cx="530"  cy="380" r="0.7"/><circle cx="1180" cy="340" r="1"/>
      <circle cx="1330" cy="290" r="0.8"/>
    </g>

    <!-- Cráteres de luna -->
    <g data-moon-craters opacity="0">
      <circle data-crater-1 cx="1135" cy="608" r="6" fill="#cbd5e1"/>
      <circle data-crater-2 cx="1105" cy="636" r="4" fill="#cbd5e1"/>
      <circle data-crater-3 cx="1140" cy="640" r="3" fill="#cbd5e1"/>
    </g>

    <!-- Big Sur curves (3 capas) -->
    <path data-wave-back  d="M 0 620 C 400 520 800 720 1200 560 C 1400 470 1500 500 1600 480 L 1600 1000 L 0 1000 Z" fill="url(#wave-1)" opacity="0.75"/>
    <path data-wave-mid   d="M 0 750 C 300 680 700 820 1100 720 C 1350 660 1500 700 1600 680 L 1600 1000 L 0 1000 Z" fill="url(#wave-2)" opacity="0.85"/>
    <path data-wave-front d="M 0 880 C 200 820 600 900 1000 860 C 1300 830 1500 870 1600 850 L 1600 1000 L 0 1000 Z" fill="url(#wave-3)" opacity="0.95"/>

    <!-- Árboles silueta sobre la wave del medio -->
    <g fill="#1e1b4b" opacity="0.55">
      <!-- pino grande -->
      <path d="M 210 780 L 195 745 L 205 750 L 200 715 L 215 725 L 210 690 L 225 705 L 220 670 L 240 700 L 235 725 L 245 725 L 240 750 L 255 750 L 250 780 Z"/>
      <!-- pino pequeño -->
      <path d="M 380 800 L 372 775 L 378 778 L 375 755 L 385 765 L 382 745 L 395 758 L 392 780 L 400 785 L 397 800 Z"/>
      <!-- caducifolio -->
      <ellipse cx="580" cy="780" rx="28" ry="22"/>
      <rect x="576" y="795" width="8" height="20"/>
      <!-- pinos derecha -->
      <path d="M 1180 770 L 1170 738 L 1178 743 L 1175 715 L 1188 727 L 1185 700 L 1200 715 L 1197 745 L 1207 748 L 1200 770 Z"/>
      <path d="M 1350 800 L 1342 775 L 1348 778 L 1345 755 L 1355 765 L 1352 745 L 1365 758 L 1362 780 L 1370 785 L 1367 800 Z"/>
    </g>

    <!-- Pájaros animados (SVG paths con CSS animation) -->
    <g class="bird bird-1" transform="translate(-100, 300)">
      <path d="M 0 0 Q 4 -5 8 0 Q 12 -5 16 0" stroke="#0f1115" stroke-width="1.6" fill="none" stroke-linecap="round" opacity="0.6"/>
    </g>
    <g class="bird bird-2" transform="translate(-100, 400)">
      <path d="M 0 0 Q 3 -3.5 6 0 Q 9 -3.5 12 0" stroke="#0f1115" stroke-width="1.3" fill="none" stroke-linecap="round" opacity="0.5"/>
    </g>
    <g class="bird bird-3" transform="translate(-100, 200)">
      <path d="M 0 0 Q 2.5 -3 5 0 Q 7.5 -3 10 0" stroke="#0f1115" stroke-width="1.1" fill="none" stroke-linecap="round" opacity="0.45"/>
    </g>
  </svg>

  <svg class="wallpaper-grain" preserveAspectRatio="none">
    <filter id="grain-wp"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="7"/><feColorMatrix values="0 0 0 0 0.5  0 0 0 0 0.5  0 0 0 0 0.5  0 0 0 0.5 0"/></filter>
    <rect width="100%" height="100%" filter="url(#grain-wp)"/>
  </svg>
</div>

<style>
  .wallpaper-root { position: fixed; inset: 0; z-index: -1; overflow: hidden; }
  .wallpaper-svg  { width: 100%; height: 100%; display: block; position: absolute; inset: 0; }
  .wallpaper-grain{ position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0.4; mix-blend-mode: overlay; }

  .bird {
    transform-origin: center;
    will-change: transform, opacity;
  }
  .bird-1 { animation: fly-across-1 55s linear infinite; }
  .bird-2 { animation: fly-across-2 70s linear infinite; animation-delay: 18s; }
  .bird-3 { animation: fly-across-3 90s linear infinite; animation-delay: 42s; }

  @keyframes fly-across-1 {
    0%   { transform: translate(-60px, 300px); opacity: 0; }
    5%   { opacity: 0.6; }
    50%  { transform: translate(800px, 260px); opacity: 0.6; }
    95%  { opacity: 0.6; }
    100% { transform: translate(1700px, 220px); opacity: 0; }
  }
  @keyframes fly-across-2 {
    0%   { transform: translate(1700px, 400px); opacity: 0; }
    8%   { opacity: 0.5; }
    50%  { transform: translate(900px, 350px); opacity: 0.5; }
    92%  { opacity: 0.5; }
    100% { transform: translate(-60px, 380px); opacity: 0; }
  }
  @keyframes fly-across-3 {
    0%   { transform: translate(-60px, 200px); opacity: 0; }
    10%  { opacity: 0.45; }
    50%  { transform: translate(700px, 250px); opacity: 0.45; }
    90%  { opacity: 0.45; }
    100% { transform: translate(1700px, 180px); opacity: 0; }
  }

  /* Reduce motion respects */
  @media (prefers-reduced-motion: reduce) {
    .bird { animation: none; opacity: 0; }
  }
</style>
