---
/**
 * Wallpaper del escritorio · sunset landscape.
 * Fixed detrás de todo. SVG + grain overlay.
 */
---
<div aria-hidden="true" style="position: fixed; inset: 0; z-index: -1; overflow: hidden;">
  <svg viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice" style="width: 100%; height: 100%; display: block;">
    <defs>
      <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#a5b4fc"/>
        <stop offset="0.35" stop-color="#fbcfe8"/>
        <stop offset="0.65" stop-color="#fed7aa"/>
        <stop offset="1" stop-color="#fdba74"/>
      </linearGradient>
      <radialGradient id="sunglow" cx="0.7" cy="0.65" r="0.35">
        <stop offset="0" stop-color="#fef3c7" stop-opacity="0.7"/>
        <stop offset="1" stop-color="#fef3c7" stop-opacity="0"/>
      </radialGradient>
    </defs>
    <rect width="1600" height="1000" fill="url(#sky)"/>
    <rect width="1600" height="1000" fill="url(#sunglow)"/>
    <circle cx="1120" cy="620" r="55" fill="#fbbf24" opacity="0.9"/>
    <circle cx="1120" cy="620" r="80" fill="#fbbf24" opacity="0.25"/>
    <path d="M0 700 L200 620 L400 680 L700 580 L900 640 L1200 600 L1600 660 L1600 1000 L0 1000 Z" fill="#7c3aed" opacity="0.3"/>
    <path d="M0 780 L150 720 L350 770 L600 700 L850 750 L1100 720 L1400 760 L1600 730 L1600 1000 L0 1000 Z" fill="#5b21b6" opacity="0.5"/>
    <path d="M0 870 L200 830 L500 860 L800 820 L1100 850 L1400 830 L1600 850 L1600 1000 L0 1000 Z" fill="#1e1b4b" opacity="0.75"/>
  </svg>
  <svg style="position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0.4; mix-blend-mode: overlay;" preserveAspectRatio="none">
    <filter id="grain-wp"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="7"/><feColorMatrix values="0 0 0 0 0.5  0 0 0 0 0.5  0 0 0 0 0.5  0 0 0 0.5 0"/></filter>
    <rect width="100%" height="100%" filter="url(#grain-wp)"/>
  </svg>
</div>
