---
interface Props {
  slug: string;
  label: string;
  accent: 'amber' | 'violet' | 'red' | 'emerald' | 'blue';
  icon: 'note' | 'box' | 'star' | 'compass' | 'mail';
}
const { slug, label, accent, icon } = Astro.props;
---
<button
  type="button"
  class="app-icon"
  data-app={slug}
  aria-label={`Abrir ${label}`}
  style={`background: transparent;`}
>
  {icon === 'note' && (
    <svg width="54" height="54" viewBox="0 0 54 54" style="display:block;">
      <defs>
        <linearGradient id={`bg-${slug}`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#fef3c7"/>
          <stop offset="1" stop-color="#fbbf24"/>
        </linearGradient>
      </defs>
      <rect width="54" height="54" rx="14" fill={`url(#bg-${slug})`}/>
      <rect x="12" y="9" width="30" height="36" rx="3" fill="#fffbeb"/>
      <rect x="12" y="9" width="30" height="7" fill="#f59e0b" opacity="0.9"/>
      <line x1="17" y1="24" x2="37" y2="24" stroke="#d97706" stroke-width="1.2" opacity="0.7"/>
      <line x1="17" y1="29" x2="37" y2="29" stroke="#d97706" stroke-width="1.2" opacity="0.6"/>
      <line x1="17" y1="34" x2="32" y2="34" stroke="#d97706" stroke-width="1.2" opacity="0.55"/>
      <line x1="17" y1="39" x2="35" y2="39" stroke="#d97706" stroke-width="1.2" opacity="0.5"/>
    </svg>
  )}
  {icon === 'box' && (
    <svg width="54" height="54" viewBox="0 0 54 54" style="display:block;">
      <defs>
        <linearGradient id={`bg-${slug}`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#ede9fe"/>
          <stop offset="1" stop-color="#7c3aed"/>
        </linearGradient>
        <linearGradient id={`box-face-${slug}`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#fff"/>
          <stop offset="1" stop-color="#e0e7ff"/>
        </linearGradient>
      </defs>
      <rect width="54" height="54" rx="14" fill={`url(#bg-${slug})`}/>
      <!-- box -->
      <path d="M27 9 L44 17 L44 37 L27 45 L10 37 L10 17 Z" fill={`url(#box-face-${slug})`} stroke="#4c1d95" stroke-width="1"/>
      <path d="M10 17 L27 25 L44 17" fill="none" stroke="#4c1d95" stroke-width="1"/>
      <path d="M27 25 L27 45" stroke="#4c1d95" stroke-width="1" opacity="0.5"/>
      <!-- ribbon -->
      <path d="M27 9 L27 25 M18.5 13 L35.5 21 M35.5 13 L18.5 21" stroke="#a855f7" stroke-width="1" opacity="0.6"/>
    </svg>
  )}
  {icon === 'star' && (
    <svg width="54" height="54" viewBox="0 0 54 54" style="display:block;">
      <defs>
        <linearGradient id={`bg-${slug}`} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#fecaca"/>
          <stop offset="0.6" stop-color="#ef4444"/>
          <stop offset="1" stop-color="#b91c1c"/>
        </linearGradient>
        <linearGradient id={`star-${slug}`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#fef9c3"/>
          <stop offset="1" stop-color="#fbbf24"/>
        </linearGradient>
      </defs>
      <rect width="54" height="54" rx="14" fill={`url(#bg-${slug})`}/>
      <path d="M27 8 L32 22 L47 22 L35 30 L39 44 L27 36 L15 44 L19 30 L7 22 L22 22 Z" fill={`url(#star-${slug})`} stroke="#78350f" stroke-width="0.8" stroke-linejoin="round"/>
      <path d="M23 15 L25 20 L20 18 Z" fill="#fff" opacity="0.5"/>
    </svg>
  )}
  {icon === 'compass' && (
    <svg width="54" height="54" viewBox="0 0 54 54" style="display:block;">
      <defs>
        <linearGradient id={`bg-${slug}`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#d1fae5"/>
          <stop offset="1" stop-color="#059669"/>
        </linearGradient>
        <radialGradient id={`face-${slug}`} cx="0.35" cy="0.3">
          <stop offset="0" stop-color="#fff"/>
          <stop offset="1" stop-color="#d1fae5"/>
        </radialGradient>
      </defs>
      <rect width="54" height="54" rx="14" fill={`url(#bg-${slug})`}/>
      <circle cx="27" cy="27" r="17" fill={`url(#face-${slug})`} stroke="#065f46" stroke-width="1.2"/>
      <!-- needle -->
      <path d="M27 13 L30 27 L27 24 Z" fill="#dc2626"/>
      <path d="M27 41 L24 27 L27 30 Z" fill="#0f1115"/>
      <circle cx="27" cy="27" r="2" fill="#0f1115"/>
      <!-- ticks -->
      <line x1="27" y1="11" x2="27" y2="13" stroke="#065f46" stroke-width="1"/>
      <line x1="43" y1="27" x2="45" y2="27" stroke="#065f46" stroke-width="1"/>
      <line x1="27" y1="41" x2="27" y2="43" stroke="#065f46" stroke-width="1"/>
      <line x1="9"  y1="27" x2="11" y2="27" stroke="#065f46" stroke-width="1"/>
    </svg>
  )}
  {icon === 'mail' && (
    <svg width="54" height="54" viewBox="0 0 54 54" style="display:block;">
      <defs>
        <linearGradient id={`bg-${slug}`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#bfdbfe"/>
          <stop offset="1" stop-color="#1e3a8a"/>
        </linearGradient>
        <linearGradient id={`env-${slug}`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#fff"/>
          <stop offset="1" stop-color="#dbeafe"/>
        </linearGradient>
      </defs>
      <rect width="54" height="54" rx="14" fill={`url(#bg-${slug})`}/>
      <rect x="9" y="16" width="36" height="24" rx="3" fill={`url(#env-${slug})`} stroke="#1e3a8a" stroke-width="0.8"/>
      <path d="M9 16 L27 30 L45 16" fill="none" stroke="#1e3a8a" stroke-width="1"/>
      <path d="M9 40 L21 27 M45 40 L33 27" fill="none" stroke="#1e3a8a" stroke-width="0.8" opacity="0.5"/>
    </svg>
  )}
  <span class="app-icon-label">{label}</span>
</button>
