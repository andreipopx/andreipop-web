---
interface Props {
  slug: string;
  label: string;
  accent: 'amber' | 'violet' | 'red' | 'emerald' | 'blue';
  icon: 'note' | 'box' | 'star' | 'compass' | 'mail';
}
const { slug, label, accent, icon } = Astro.props;

const backgrounds: Record<Props['accent'], string> = {
  amber:   'linear-gradient(135deg, #fef3c7, #fbbf24)',
  violet:  'linear-gradient(135deg, #ddd6fe, #7c3aed)',
  red:     'linear-gradient(135deg, #fecaca, #ef4444)',
  emerald: 'linear-gradient(135deg, #d1fae5, #059669)',
  blue:    'linear-gradient(135deg, #bfdbfe, #1e3a8a)',
};
const strokeColors: Record<Props['accent'], string> = {
  amber: '#92400e', violet: '#4c1d95', red: '#7f1d1d', emerald: '#065f46', blue: '#1e3a8a',
};
const strokeColor = strokeColors[accent];
---
<button
  type="button"
  class="app-icon"
  style={`background: ${backgrounds[accent]}`}
  data-app={slug}
  aria-label={`Abrir ${label}`}
>
  {icon === 'note' && (
    <svg width="30" height="30" viewBox="0 0 32 32" fill="none">
      <rect x="6" y="4" width="20" height="24" rx="3" fill="#fff" stroke={strokeColor} stroke-width="1.5"/>
      <line x1="10" y1="10" x2="22" y2="10" stroke={strokeColor} stroke-width="1.4"/>
      <line x1="10" y1="15" x2="22" y2="15" stroke={strokeColor} stroke-width="1.4"/>
      <line x1="10" y1="20" x2="18" y2="20" stroke={strokeColor} stroke-width="1.4"/>
    </svg>
  )}
  {icon === 'box' && (
    <svg width="30" height="30" viewBox="0 0 32 32" fill="none">
      <path d="M5 10 L16 5 L27 10 L27 22 L16 27 L5 22 Z" fill="#fff" stroke={strokeColor} stroke-width="1.5" stroke-linejoin="round"/>
      <path d="M5 10 L16 15 L27 10 M16 15 L16 27" stroke={strokeColor} stroke-width="1.4" fill="none"/>
    </svg>
  )}
  {icon === 'star' && (
    <svg width="30" height="30" viewBox="0 0 32 32" fill="none">
      <path d="M16 4 L19 12 L28 12 L21 17 L23 26 L16 21 L9 26 L11 17 L4 12 L13 12 Z" fill="#fff" stroke={strokeColor} stroke-width="1.5" stroke-linejoin="round"/>
    </svg>
  )}
  {icon === 'compass' && (
    <svg width="30" height="30" viewBox="0 0 32 32" fill="none">
      <circle cx="16" cy="16" r="12" fill="#fff" stroke={strokeColor} stroke-width="1.5"/>
      <path d="M16 8 L18 15 L24 16 L18 17 L16 24 L14 17 L8 16 L14 15 Z" fill={strokeColor}/>
    </svg>
  )}
  {icon === 'mail' && (
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
      <rect x="2" y="4" width="20" height="16" rx="2" fill="#fff" stroke={strokeColor} stroke-width="1.7"/>
      <path d="M22 6 L12 13 L2 6" stroke={strokeColor} stroke-width="1.7" fill="none"/>
    </svg>
  )}
  <span class="app-icon-label">{label}</span>
</button>
