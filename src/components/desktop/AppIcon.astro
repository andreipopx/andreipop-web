---
interface Props {
  slug: string;
  label: string;
  icon: 'note' | 'box' | 'star' | 'compass' | 'mail' | 'photos' | 'pen';
  secondary?: boolean;
}
const { slug, label, icon, secondary } = Astro.props;

const iconVars: Record<Props['icon'], string> = {
  note:    'note',
  box:     'box',
  star:    'star',
  compass: 'compass',
  mail:    'mail',
  photos:  'photos',
  pen:     'pen',
};
const v = iconVars[icon];
const fromCss = `var(--icon-${v}-from)`;
const toCss   = `var(--icon-${v}-to)`;
---
<button
  type="button"
  class:list={['app-icon', { 'is-secondary': secondary }]}
  data-app={slug}
  aria-label={`Abrir ${label}`}
  style="background: transparent;"
>
  {icon === 'note' && (
    <svg width="54" height="54" viewBox="0 0 54 54" style="display:block;">
      <defs><linearGradient id={`bg-${slug}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" style={`stop-color: ${fromCss}`}/><stop offset="1" style={`stop-color: ${toCss}`}/></linearGradient></defs>
      <rect width="54" height="54" rx="14" fill={`url(#bg-${slug})`}/>
      <rect x="12" y="9" width="30" height="36" rx="3" fill="#fffbeb"/>
      <rect x="12" y="9" width="30" height="7" fill="#f59e0b" opacity="0.9"/>
      <line x1="17" y1="24" x2="37" y2="24" stroke={toCss} stroke-width="1.2" opacity="0.7"/>
      <line x1="17" y1="29" x2="37" y2="29" stroke={toCss} stroke-width="1.2" opacity="0.6"/>
      <line x1="17" y1="34" x2="32" y2="34" stroke={toCss} stroke-width="1.2" opacity="0.55"/>
      <line x1="17" y1="39" x2="35" y2="39" stroke={toCss} stroke-width="1.2" opacity="0.5"/>
    </svg>
  )}
  {icon === 'box' && (
    <svg width="54" height="54" viewBox="0 0 54 54" style="display:block;">
      <defs><linearGradient id={`bg-${slug}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" style={`stop-color: ${fromCss}`}/><stop offset="1" style={`stop-color: ${toCss}`}/></linearGradient></defs>
      <rect width="54" height="54" rx="14" fill={`url(#bg-${slug})`}/>
      <path d="M27 9 L44 17 L44 37 L27 45 L10 37 L10 17 Z" fill="#fff" opacity="0.95" stroke={toCss} stroke-width="1"/>
      <path d="M10 17 L27 25 L44 17" fill="none" stroke={toCss} stroke-width="1"/>
      <path d="M27 25 L27 45" stroke={toCss} stroke-width="1" opacity="0.5"/>
      <path d="M27 9 L27 25 M18.5 13 L35.5 21 M35.5 13 L18.5 21" stroke={toCss} stroke-width="1" opacity="0.6"/>
    </svg>
  )}
  {icon === 'star' && (
    <svg width="54" height="54" viewBox="0 0 54 54" style="display:block;">
      <defs><linearGradient id={`bg-${slug}`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" style={`stop-color: ${fromCss}`}/><stop offset="1" style={`stop-color: ${toCss}`}/></linearGradient></defs>
      <rect width="54" height="54" rx="14" fill={`url(#bg-${slug})`}/>
      <path d="M27 8 L32 22 L47 22 L35 30 L39 44 L27 36 L15 44 L19 30 L7 22 L22 22 Z" fill="#fef9c3" stroke="#78350f" stroke-width="0.8" stroke-linejoin="round"/>
    </svg>
  )}
  {icon === 'compass' && (
    <svg width="54" height="54" viewBox="0 0 54 54" style="display:block;">
      <defs><linearGradient id={`bg-${slug}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" style={`stop-color: ${fromCss}`}/><stop offset="1" style={`stop-color: ${toCss}`}/></linearGradient></defs>
      <rect width="54" height="54" rx="14" fill={`url(#bg-${slug})`}/>
      <circle cx="27" cy="27" r="17" fill="#fff" opacity="0.95" stroke={toCss} stroke-width="1.2"/>
      <path d="M27 13 L30 27 L27 24 Z" fill="#dc2626"/>
      <path d="M27 41 L24 27 L27 30 Z" fill="#0f1115"/>
      <circle cx="27" cy="27" r="2" fill="#0f1115"/>
    </svg>
  )}
  {icon === 'mail' && (
    <svg width="54" height="54" viewBox="0 0 54 54" style="display:block;">
      <defs><linearGradient id={`bg-${slug}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" style={`stop-color: ${fromCss}`}/><stop offset="1" style={`stop-color: ${toCss}`}/></linearGradient></defs>
      <rect width="54" height="54" rx="14" fill={`url(#bg-${slug})`}/>
      <rect x="9" y="16" width="36" height="24" rx="3" fill="#fff" opacity="0.95" stroke={toCss} stroke-width="0.8"/>
      <path d="M9 16 L27 30 L45 16" fill="none" stroke={toCss} stroke-width="1"/>
    </svg>
  )}
  {icon === 'photos' && (
    <svg width="54" height="54" viewBox="0 0 54 54" style="display:block;">
      <defs>
        <linearGradient id={`bg-${slug}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" style={`stop-color: ${fromCss}`}/><stop offset="1" style={`stop-color: ${toCss}`}/></linearGradient>
        <linearGradient id={`sky-${slug}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#a5b4fc"/><stop offset="0.5" stop-color="#fbcfe8"/><stop offset="1" stop-color="#fed7aa"/></linearGradient>
      </defs>
      <rect width="54" height="54" rx="14" fill={`url(#bg-${slug})`}/>
      <rect x="10" y="12" width="34" height="26" rx="3" fill="#fff" opacity="0.95" stroke={toCss} stroke-width="0.8"/>
      <rect x="12" y="14" width="30" height="18" fill={`url(#sky-${slug})`}/>
      <circle cx="35" cy="20" r="3" fill="#fbbf24" opacity="0.9"/>
      <path d="M12 32 L18 26 L25 30 L32 24 L42 32 Z" fill="#7c3aed" opacity="0.7"/>
      <circle cx="27" cy="42" r="3" fill={toCss}/>
      <circle cx="27" cy="42" r="1.5" fill="#fff"/>
    </svg>
  )}
  {icon === 'pen' && (
    <svg width="54" height="54" viewBox="0 0 54 54" style="display:block;">
      <defs><linearGradient id={`bg-${slug}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" style={`stop-color: ${fromCss}`}/><stop offset="1" style={`stop-color: ${toCss}`}/></linearGradient></defs>
      <rect width="54" height="54" rx="14" fill={`url(#bg-${slug})`}/>
      <rect x="10" y="12" width="24" height="30" rx="1" fill="#fff" opacity="0.95" stroke={toCss} stroke-width="0.6"/>
      <line x1="14" y1="20" x2="30" y2="20" stroke={toCss} stroke-width="0.6" opacity="0.4"/>
      <line x1="14" y1="26" x2="28" y2="26" stroke={toCss} stroke-width="0.6" opacity="0.4"/>
      <path d="M17 37 Q19 34 22 37 Q25 40 28 36" fill="none" stroke={toCss} stroke-width="1.2" stroke-linecap="round"/>
      <path d="M38 10 L48 10 L46 20 L36 42 L32 44 L34 40 L44 18 Z" fill="#0f1115" stroke={toCss} stroke-width="0.6" stroke-linejoin="round"/>
      <path d="M32 44 L34 40 L36 42 Z" fill="#dbeafe"/>
    </svg>
  )}
  <span class="app-icon-label">{label}</span>
</button>
