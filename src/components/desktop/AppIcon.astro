---
interface Props {
  slug: string;
  label: string;
  icon: 'note' | 'box' | 'star' | 'compass' | 'mail' | 'photos' | 'pen';
  secondary?: boolean;
}
const { slug, label, icon, secondary } = Astro.props;

const fromCss = `var(--icon-${icon}-from)`;
const toCss   = `var(--icon-${icon}-to)`;
---
<button
  type="button"
  class:list={['app-icon', { 'is-secondary': secondary }]}
  data-app={slug}
  aria-label={`Abrir ${label}`}
  style="background: transparent;"
>
  {icon === 'note' && (
    <svg width="54" height="54" viewBox="0 0 54 54" style="display:block;">
      <defs><linearGradient id={`bg-${slug}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" style={`stop-color: ${fromCss}`}/><stop offset="1" style={`stop-color: ${toCss}`}/></linearGradient></defs>
      <rect width="54" height="54" rx="14" fill={`url(#bg-${slug})`}/>
      <rect x="14" y="12" width="26" height="30" rx="2" fill="#fff"/>
      <line x1="18" y1="21" x2="36" y2="21" stroke={toCss} stroke-width="1.8" stroke-linecap="round"/>
      <line x1="18" y1="27" x2="36" y2="27" stroke={toCss} stroke-width="1.8" stroke-linecap="round"/>
      <line x1="18" y1="33" x2="30" y2="33" stroke={toCss} stroke-width="1.8" stroke-linecap="round"/>
    </svg>
  )}
  {icon === 'box' && (
    <svg width="54" height="54" viewBox="0 0 54 54" style="display:block;">
      <defs><linearGradient id={`bg-${slug}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" style={`stop-color: ${fromCss}`}/><stop offset="1" style={`stop-color: ${toCss}`}/></linearGradient></defs>
      <rect width="54" height="54" rx="14" fill={`url(#bg-${slug})`}/>
      <path d="M27 12 L42 19 L42 35 L27 42 L12 35 L12 19 Z" fill="#fff"/>
      <path d="M12 19 L27 26 L42 19" stroke={toCss} stroke-width="1.6" fill="none" stroke-linejoin="round"/>
      <path d="M27 26 L27 42" stroke={toCss} stroke-width="1.6"/>
    </svg>
  )}
  {icon === 'star' && (
    <svg width="54" height="54" viewBox="0 0 54 54" style="display:block;">
      <defs><linearGradient id={`bg-${slug}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" style={`stop-color: ${fromCss}`}/><stop offset="1" style={`stop-color: ${toCss}`}/></linearGradient></defs>
      <rect width="54" height="54" rx="14" fill={`url(#bg-${slug})`}/>
      <path d="M27 10 L32 22 L45 22 L34 30 L38 43 L27 35 L16 43 L20 30 L9 22 L22 22 Z" fill="#fff" stroke-linejoin="round"/>
    </svg>
  )}
  {icon === 'compass' && (
    <svg width="54" height="54" viewBox="0 0 54 54" style="display:block;">
      <defs><linearGradient id={`bg-${slug}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" style={`stop-color: ${fromCss}`}/><stop offset="1" style={`stop-color: ${toCss}`}/></linearGradient></defs>
      <rect width="54" height="54" rx="14" fill={`url(#bg-${slug})`}/>
      <circle cx="27" cy="27" r="16" fill="#fff"/>
      <path d="M27 13 L31 27 L27 24 Z" fill="#ef4444"/>
      <path d="M27 41 L23 27 L27 30 Z" fill={toCss}/>
      <circle cx="27" cy="27" r="2" fill={toCss}/>
    </svg>
  )}
  {icon === 'mail' && (
    <svg width="54" height="54" viewBox="0 0 54 54" style="display:block;">
      <defs><linearGradient id={`bg-${slug}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" style={`stop-color: ${fromCss}`}/><stop offset="1" style={`stop-color: ${toCss}`}/></linearGradient></defs>
      <rect width="54" height="54" rx="14" fill={`url(#bg-${slug})`}/>
      <rect x="9" y="17" width="36" height="22" rx="2" fill="#fff"/>
      <path d="M9 17 L27 30 L45 17" stroke={toCss} stroke-width="1.8" fill="none" stroke-linejoin="round"/>
    </svg>
  )}
  {icon === 'photos' && (
    <svg width="54" height="54" viewBox="0 0 54 54" style="display:block;">
      <defs>
        <linearGradient id={`bg-${slug}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" style={`stop-color: ${fromCss}`}/><stop offset="1" style={`stop-color: ${toCss}`}/></linearGradient>
        <linearGradient id={`sky-${slug}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#a5b4fc"/><stop offset="1" stop-color="#fbcfe8"/></linearGradient>
      </defs>
      <rect width="54" height="54" rx="14" fill={`url(#bg-${slug})`}/>
      <rect x="10" y="14" width="34" height="26" rx="2" fill="#fff"/>
      <rect x="13" y="17" width="28" height="18" fill={`url(#sky-${slug})`}/>
      <path d="M13 30 L20 24 L27 28 L35 22 L41 30 L41 35 L13 35 Z" fill={toCss}/>
      <circle cx="35" cy="21" r="2.5" fill="#fef08a"/>
    </svg>
  )}
  {icon === 'pen' && (
    <svg width="54" height="54" viewBox="0 0 54 54" style="display:block;">
      <defs><linearGradient id={`bg-${slug}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" style={`stop-color: ${fromCss}`}/><stop offset="1" style={`stop-color: ${toCss}`}/></linearGradient></defs>
      <rect width="54" height="54" rx="14" fill={`url(#bg-${slug})`}/>
      <rect x="10" y="14" width="24" height="28" rx="2" fill="#fff"/>
      <path d="M15 34 Q19 30 24 34 Q28 37 32 32" fill="none" stroke={toCss} stroke-width="2" stroke-linecap="round"/>
      <path d="M38 10 L46 10 L44 18 L34 40 L30 42 L32 38 L42 16 Z" fill={toCss}/>
      <path d="M30 42 L32 38 L34 40 Z" fill="#fff"/>
    </svg>
  )}
  <span class="app-icon-label">{label}</span>
</button>
