---
import Window from './Window.astro';
import { site } from '../../config/site';
---
<Window slug="firma" title="Firma — guestbook" x={220} y={130} width={540} height={640} z={100}>
  <div class="firma-shell">

    <!-- Form -->
    <form data-firma-form style="padding: 18px 24px 16px; border-bottom: 1px solid var(--color-border); display: flex; flex-direction: column; gap: 10px; flex-shrink: 0;">
      <div class="cap" style="margin-bottom: 2px;">Deja tu firma</div>
      <input
        type="text" name="nombre" placeholder="Tu nombre" required maxlength="60"
        style="padding: 9px 12px; border: 1px solid var(--color-border); border-radius: 8px; background: transparent; color: var(--color-ink); font-family: inherit; font-size: 14px; outline: none;"
      />
      <textarea
        name="mensaje" placeholder="Un mensaje" required maxlength="500" rows="2"
        style="padding: 9px 12px; border: 1px solid var(--color-border); border-radius: 8px; background: transparent; color: var(--color-ink); font-family: inherit; font-size: 14px; resize: vertical; outline: none; min-height: 60px;"
      ></textarea>
      <div class="firma-form-row">
        <!-- Turnstile widget renderizado con explicit callback -->
        <div data-turnstile-container class="firma-turnstile">
          <div style="font-size: 11px; color: var(--color-muted);" data-turnstile-status>Cargando verificación…</div>
        </div>
        <button
          type="submit"
          data-firma-submit
          disabled
          style="padding: 9px 18px; background: var(--color-indigo); color: #fff; border: none; border-radius: 999px; font-size: 13px; font-weight: 500; cursor: pointer; opacity: 0.6; white-space: nowrap;"
        >
          Firmar
        </button>
      </div>
      <div data-firma-msg style="font-size: 11px; color: var(--color-muted); min-height: 14px;"></div>
    </form>

    <!-- Lista firmas -->
    <div class="firma-list-head" style="padding: 16px 24px 8px; flex-shrink: 0;">
      <div class="cap">Últimas firmas · <span data-firma-count>—</span></div>
    </div>
    <div data-firmas-list class="firma-list" style="padding: 0 24px 24px;">
      <div style="text-align: center; color: var(--color-muted); padding: 20px; font-size: 13px;">Cargando…</div>
    </div>

  </div>
</Window>

<style>
  /* Desktop: form fijo arriba, lista scrollea dentro */
  .firma-shell { display: flex; flex-direction: column; height: 100%; }
  .firma-list { flex: 1; overflow-y: auto; min-height: 0; }

  /* Form: fila horizontal Turnstile + botón (aprovecha ancho, ahorra alto) */
  .firma-form-row {
    display: flex; align-items: center; gap: 12px;
    justify-content: space-between;
  }
  .firma-turnstile {
    min-height: 30px;
    display: flex; align-items: center;
    flex: 1;
  }

  /* Firmas: más presencia, más aire, tipografía más grande */
  :global(.firma-item) {
    padding: 18px 0;
    border-top: 1px solid var(--color-border);
  }
  :global(.firma-item:first-child) { border-top: none; padding-top: 8px; }
  :global(.firma-item-head) {
    display: flex; justify-content: space-between; align-items: baseline;
    gap: 12px; margin-bottom: 6px;
  }
  :global(.firma-item-name) {
    font-size: 15px; font-weight: 600;
    color: var(--color-ink);
    letter-spacing: -0.01em;
  }
  :global(.firma-item-date) {
    font-size: 10px; color: var(--color-muted);
    text-transform: uppercase; letter-spacing: 0.06em;
  }
  :global(.firma-item-body) {
    font-size: 15px; color: var(--color-ink);
    line-height: 1.55; white-space: pre-wrap;
  }

  /* Mobile: sin scroll anidado — scrollea la propia ventana */
  @media (max-width: 768px) {
    .firma-shell { display: block; height: auto; }
    .firma-list { flex: none; overflow: visible; }
    .firma-form-row { flex-direction: column; align-items: stretch; gap: 10px; }
    .firma-turnstile { justify-content: flex-start; }
  }
</style>

<script define:vars={{ API: site.api.baseUrl, SITE_KEY: site.api.turnstileSiteKey }}>
  const win = document.querySelector('[data-window="firma"]');
  if (win) {
    const listEl    = win.querySelector('[data-firmas-list]');
    const countEl   = win.querySelector('[data-firma-count]');
    const form      = win.querySelector('[data-firma-form]');
    const msgEl     = win.querySelector('[data-firma-msg]');
    const submitBtn = win.querySelector('[data-firma-submit]');
    const container = win.querySelector('[data-turnstile-container]');
    const statusEl  = win.querySelector('[data-turnstile-status]');

    let currentToken = null;
    let widgetId = null;

    const fmt = (iso) => new Date(iso).toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' }).replace('.', '');
    const escape = (s) => String(s).replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

    const enableSubmit = () => {
      if (submitBtn) { submitBtn.disabled = false; submitBtn.style.opacity = '1'; }
    };
    const disableSubmit = () => {
      if (submitBtn) { submitBtn.disabled = true; submitBtn.style.opacity = '0.6'; }
    };

    const renderTurnstile = () => {
      if (!window.turnstile || !container) return;
      // Limpia el placeholder
      container.innerHTML = '';
      widgetId = window.turnstile.render(container, {
        sitekey: SITE_KEY,
        theme: document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light',
        size: 'compact',
        callback: (token) => {
          currentToken = token;
          enableSubmit();
          if (statusEl) statusEl.textContent = '';
        },
        'expired-callback': () => {
          currentToken = null;
          disableSubmit();
        },
        'error-callback': () => {
          currentToken = null;
          disableSubmit();
          if (msgEl) msgEl.textContent = 'Error de verificación. Refresca la página.';
        },
      });
    };

    // Turnstile puede cargar antes o después de este script — cubrimos ambos casos
    const waitForTurnstile = () => {
      if (window.turnstile) { renderTurnstile(); return; }
      let tries = 0;
      const iv = setInterval(() => {
        if (window.turnstile || tries++ > 50) {
          clearInterval(iv);
          if (window.turnstile) renderTurnstile();
          else if (statusEl) statusEl.textContent = 'No se pudo cargar la verificación anti-bot.';
        }
      }, 200);
    };
    waitForTurnstile();

    const render = (firmas) => {
      if (countEl) countEl.textContent = String(firmas.length);
      if (!listEl) return;
      if (firmas.length === 0) {
        listEl.innerHTML = '<div style="text-align:center;color:var(--color-muted);padding:20px;font-size:13px;">Todavía nadie ha firmado. Sé el primero.</div>';
        return;
      }
      listEl.innerHTML = firmas.map((f) => `
        <div class="firma-item">
          <div class="firma-item-head">
            <strong class="firma-item-name">${escape(f.nombre)}</strong>
            <span class="mono firma-item-date">${fmt(f.date)}</span>
          </div>
          <div class="firma-item-body">${escape(f.mensaje)}</div>
        </div>
      `).join('');
    };

    const load = async () => {
      try {
        const r = await fetch(`${API}/firmas`);
        const data = await r.json();
        render(data.firmas || []);
      } catch {
        if (listEl) listEl.innerHTML = '<div style="text-align:center;color:var(--color-muted);padding:20px;font-size:13px;">No se pudo cargar. Refresca la página.</div>';
      }
    };

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const nombre  = fd.get('nombre');
      const mensaje = fd.get('mensaje');
      if (!currentToken) {
        if (msgEl) msgEl.textContent = 'Aún no se ha completado la verificación anti-bot. Espera un segundo.';
        return;
      }
      disableSubmit();
      if (msgEl) msgEl.textContent = 'Enviando…';
      let r, data, errorDetail = '';
      try {
        r = await fetch(`${API}/firmas`, {
          method: 'POST',
          mode: 'cors',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ nombre, mensaje, token: currentToken }),
        });
      } catch (err) {
        console.error('[firma] fetch failed:', err);
        if (msgEl) msgEl.textContent = 'Error de red: ' + (err?.message || 'no se pudo conectar');
        enableSubmit();
        currentToken = null;
        if (widgetId !== null && window.turnstile) window.turnstile.reset(widgetId);
        return;
      }
      try {
        data = await r.json();
      } catch (err) {
        console.error('[firma] json parse failed:', err, 'status:', r?.status);
        if (msgEl) msgEl.textContent = `Respuesta inesperada (HTTP ${r?.status ?? '?'})`;
        enableSubmit();
        currentToken = null;
        if (widgetId !== null && window.turnstile) window.turnstile.reset(widgetId);
        return;
      }
      if (!r.ok) {
        if (msgEl) msgEl.textContent = `Error (${r.status}): ${data.error || 'no se pudo firmar'}`;
        currentToken = null;
        if (widgetId !== null && window.turnstile) window.turnstile.reset(widgetId);
        return;
      }
      if (msgEl) msgEl.textContent = '✓ Gracias por firmar';
      form.reset();
      currentToken = null;
      if (widgetId !== null && window.turnstile) window.turnstile.reset(widgetId);
      load();
    });

    load();
  }
</script>
