---
import Window from './Window.astro';
import { site } from '../../config/site';
---
<Window slug="firma" title="Firma — guestbook" x={220} y={130} width={540} height={640} z={100}>
  <div class="firma-shell">

    <!-- Form -->
    <form data-firma-form data-api={site.api.baseUrl} data-sitekey={site.api.turnstileSiteKey} style="padding: 18px 24px 16px; border-bottom: 1px solid var(--color-border); display: flex; flex-direction: column; gap: 10px; flex-shrink: 0;">
      <div class="cap" style="margin-bottom: 2px;">Deja tu firma</div>
      <input
        type="text" name="nombre" placeholder="Tu nombre" required maxlength="60"
        style="padding: 9px 12px; border: 1px solid var(--color-border); border-radius: 8px; background: transparent; color: var(--color-ink); font-family: inherit; font-size: 14px; outline: none;"
      />
      <textarea
        name="mensaje" placeholder="Un mensaje" required maxlength="500" rows="2"
        style="padding: 9px 12px; border: 1px solid var(--color-border); border-radius: 8px; background: transparent; color: var(--color-ink); font-family: inherit; font-size: 14px; resize: vertical; outline: none; min-height: 60px;"
      ></textarea>
      <!-- Turnstile invisible: sólo se muestra si Cloudflare necesita reto -->
      <div data-turnstile-container class="firma-turnstile"></div>
      <div class="firma-form-row">
        <span data-turnstile-status class="firma-status"></span>
        <button
          type="submit"
          data-firma-submit
          style="padding: 9px 20px; background: var(--color-indigo); color: #fff; border: none; border-radius: 999px; font-size: 13px; font-weight: 500; cursor: pointer; white-space: nowrap;"
        >
          Firmar
        </button>
      </div>
      <div data-firma-msg style="font-size: 11px; color: var(--color-muted); min-height: 14px;"></div>
    </form>

    <!-- Lista firmas -->
    <div class="firma-list-head" style="padding: 16px 24px 8px; flex-shrink: 0;">
      <div class="cap">Últimas firmas · <span data-firma-count>—</span></div>
    </div>
    <div data-firmas-list class="firma-list" style="padding: 0 24px 24px;">
      <div style="text-align: center; color: var(--color-muted); padding: 20px; font-size: 13px;">Cargando…</div>
    </div>

  </div>
</Window>

<style>
  /* Desktop: form fijo arriba, lista scrollea dentro */
  .firma-shell { display: flex; flex-direction: column; height: 100%; }
  .firma-list { flex: 1; overflow-y: auto; min-height: 0; }

  /* Form: fila con botón alineado a la derecha */
  .firma-form-row {
    display: flex; align-items: center; gap: 12px;
    justify-content: flex-end;
  }
  .firma-status {
    font-size: 11px; color: var(--color-muted);
    flex: 1;
  }
  /* Turnstile invisible: sin ocupar espacio salvo que aparezca un reto */
  .firma-turnstile:empty { display: none; }
  .firma-turnstile { display: flex; justify-content: center; }

  /* Firmas: más presencia, más aire, tipografía más grande */
  :global(.firma-item) {
    padding: 18px 0;
    border-top: 1px solid var(--color-border);
  }
  :global(.firma-item:first-child) { border-top: none; padding-top: 8px; }
  :global(.firma-item-head) {
    display: flex; justify-content: space-between; align-items: baseline;
    gap: 12px; margin-bottom: 6px;
  }
  :global(.firma-item-name) {
    font-size: 15px; font-weight: 600;
    color: var(--color-ink);
    letter-spacing: -0.01em;
  }
  :global(.firma-item-date) {
    font-size: 10px; color: var(--color-muted);
    text-transform: uppercase; letter-spacing: 0.06em;
  }
  :global(.firma-item-body) {
    font-size: 15px; color: var(--color-ink);
    line-height: 1.55; white-space: pre-wrap;
  }

  /* Mobile: sin scroll anidado — scrollea la propia ventana */
  @media (max-width: 768px) {
    .firma-shell { display: block; height: auto; }
    .firma-list { flex: none; overflow: visible; }
  }
</style>


<script>
  import { createVerifier, verifMessage, getJson } from '../../scripts/verificacion';

  type Firma = { id: string; nombre: string; mensaje: string; date: string };

  const win = document.querySelector<HTMLElement>('[data-window="firma"]');
  const form = win?.querySelector<HTMLFormElement>('[data-firma-form]');
  if (win && form) {
    const API = form.dataset.api!;
    const listEl    = win.querySelector<HTMLElement>('[data-firmas-list]')!;
    const countEl   = win.querySelector<HTMLElement>('[data-firma-count]')!;
    const msgEl     = win.querySelector<HTMLElement>('[data-firma-msg]')!;
    const submitBtn = win.querySelector<HTMLButtonElement>('[data-firma-submit]')!;
    const statusEl  = win.querySelector<HTMLElement>('[data-turnstile-status]')!;
    const verifier  = createVerifier(
      win.querySelector<HTMLElement>('[data-turnstile-container]')!,
      form.dataset.sitekey!,
      {
        onInteractive: () => { statusEl.textContent = 'Marca la casilla para confirmar que eres humano.'; },
        onToken: () => { statusEl.textContent = ''; },
      },
    );

    let firmas: Firma[] = [];

    const fmt = (iso: string) => new Date(iso).toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' }).replace('.', '');
    const escape = (s: unknown) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
    const note = (html: string) => `<div style="text-align:center;color:var(--color-muted);padding:20px;font-size:13px;">${html}</div>`;

    const setBusy = (busy: boolean) => {
      submitBtn.disabled = busy;
      submitBtn.style.opacity = busy ? '0.6' : '1';
    };

    const render = () => {
      countEl.textContent = String(firmas.length);
      if (firmas.length === 0) {
        listEl.innerHTML = note('Todavía nadie ha firmado. Sé el primero.');
        return;
      }
      listEl.innerHTML = firmas.map((f) => `
        <div class="firma-item">
          <div class="firma-item-head">
            <strong class="firma-item-name">${escape(f.nombre)}</strong>
            <span class="mono firma-item-date">${fmt(f.date)}</span>
          </div>
          <div class="firma-item-body">${escape(f.mensaje)}</div>
        </div>
      `).join('');
    };

    const load = async () => {
      listEl.innerHTML = note('Cargando…');
      try {
        const data = await getJson<{ firmas?: Firma[] }>(`${API}/firmas`);
        firmas = data.firmas || [];
        render();
      } catch (err) {
        countEl.textContent = '—';
        listEl.innerHTML = note(`No se han podido cargar las firmas (${escape((err as Error).message)}).<br>
          <button type="button" data-firma-retry style="margin-top:10px;padding:6px 14px;border:1px solid var(--color-border);border-radius:999px;background:transparent;color:var(--color-ink);font:inherit;font-size:12px;cursor:pointer;">Reintentar</button>`);
        listEl.querySelector('[data-firma-retry]')?.addEventListener('click', load);
      }
    };

    // La verificación arranca cuando el usuario se pone a escribir
    form.addEventListener('focusin', () => verifier.warm(), { once: true });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const nombre  = fd.get('nombre');
      const mensaje = fd.get('mensaje');
      setBusy(true);
      msgEl.textContent = '';
      if (!statusEl.textContent) statusEl.textContent = 'Verificando…';

      let token: string;
      try {
        token = await verifier.getToken();
      } catch (err) {
        statusEl.textContent = '';
        msgEl.textContent = verifMessage(err);
        setBusy(false);
        return;
      }

      statusEl.textContent = 'Enviando…';
      let r: Response, data: any;
      try {
        r = await fetch(`${API}/firmas`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ nombre, mensaje, token }),
        });
        data = await r.json().catch(() => ({}));
      } catch (err) {
        console.error('[firma] fetch failed:', err);
        statusEl.textContent = '';
        msgEl.textContent = 'No hay conexión con el servidor. Dale otra vez en un momento.';
        verifier.consume();
        setBusy(false);
        return;
      }
      verifier.consume();
      statusEl.textContent = '';
      setBusy(false);

      if (!r.ok) {
        msgEl.textContent = r.status === 403
          ? 'La verificación ha caducado. Dale otra vez a Firmar.'
          : `No se pudo firmar: ${data.error || `HTTP ${r.status}`}`;
        return;
      }
      msgEl.textContent = '✓ Gracias por firmar';
      form.reset();
      // Pintamos la firma nueva al momento: el KV de Cloudflare puede tardar
      // hasta un minuto en devolverla en otras lecturas.
      if (data.firma) {
        firmas = [data.firma, ...firmas.filter((f) => f.id !== data.firma.id)];
        render();
      }
    });

    load();
  }
</script>
