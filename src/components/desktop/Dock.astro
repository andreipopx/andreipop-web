---
import { site } from '../../config/site';
import AppIcon from './AppIcon.astro';

// Primero 4 apps son "primary" (siempre visibles en el dock, también en mobile).
// El resto excepto Contacto son "secondary" (visibles en desktop; en mobile
// se acceden vía botón "more").
// Contacto siempre al final, separado.
const primary   = site.apps.filter((a) => a.slug !== 'contacto').slice(0, 4);
const secondary = site.apps.filter((a) => a.slug !== 'contacto').slice(4);
const contacto  = site.apps.find((a) => a.slug === 'contacto')!;
---
<nav class="dock" aria-label="Dock">
  {primary.map((app) => (
    <AppIcon slug={app.slug} label={app.label} icon={app.icon} />
  ))}
  {secondary.map((app) => (
    <AppIcon slug={app.slug} label={app.label} icon={app.icon} secondary={true} />
  ))}
  <!-- More button (solo mobile) -->
  <button
    type="button"
    class="dock-more"
    data-dock-more
    aria-label="Más apps"
    aria-expanded="false"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
      <circle cx="5" cy="12" r="1"/>
      <circle cx="12" cy="12" r="1"/>
      <circle cx="19" cy="12" r="1"/>
    </svg>
  </button>
  <div class="dock-sep" aria-hidden="true"></div>
  <AppIcon slug={contacto.slug} label={contacto.label} icon={contacto.icon} />
</nav>

<!-- Overflow menu (solo aparece en mobile al pulsar "more") -->
<div class="dock-overflow" data-dock-overflow>
  {secondary.map((app) => (
    <AppIcon slug={app.slug} label={app.label} icon={app.icon} />
  ))}
</div>
