---
import Window from './Window.astro';
import { getCollection } from 'astro:content';

const cosas = (await getCollection('cosas'))
  .filter((c) => !c.data.draft)
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const gradients: Record<string, string> = {
  indigo:  'linear-gradient(160deg, #1e3a8a, #4338ca 60%, #7c3aed)',
  orange:  'linear-gradient(160deg, #f97316, #ef4444)',
  emerald: 'linear-gradient(160deg, #10b981, #059669)',
  violet:  'linear-gradient(160deg, #7c3aed, #a855f7)',
  amber:   'linear-gradient(160deg, #f59e0b, #f97316)',
};
---
<Window slug="cosas" title={`Cosas — ${cosas.length}`} x={200} y={140} width={720} height={560} z={100}>
  {cosas.length === 0 ? (
    <div style="padding: 48px 32px; text-align: center;">
      <div class="cap" style="margin-bottom: 12px;">Cosas</div>
      <div style="font-size: 22px; font-weight: 600; letter-spacing: -0.02em;">Todavía sin cosas.</div>
    </div>
  ) : (
    <div style="padding: 20px; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px;">
      {cosas.map((c) => {
        const externalHref = c.data.url ?? c.data.repo;
        const cardStyle = `background: ${gradients[c.data.accent] ?? gradients.indigo}; border-radius: 16px; padding: 20px; display: flex; flex-direction: column; justify-content: space-between; min-height: 200px; color: #fff; text-decoration: none;`;
        const inner = (
          <>
            <div style="width: 36px; height: 36px; border-radius: 10px; background: rgba(255,255,255,0.9); color: #0f1115; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 18px;">
              {c.data.initial}
            </div>
            <div>
              <div style="font-size: 24px; font-weight: 700; letter-spacing: -0.025em;">{c.data.title}</div>
              <div style="font-size: 13px; opacity: 0.9; margin-top: 6px; line-height: 1.5;">{c.data.tagline}</div>
              <div class="mono" style="font-size: 10px; opacity: 0.75; margin-top: 10px; letter-spacing: 0.06em; text-transform: uppercase; display: flex; gap: 8px; align-items: center;">
                <span>{c.data.kind} · {c.data.year}</span>
                {externalHref && <span>↗</span>}
              </div>
            </div>
          </>
        );
        return externalHref ? (
          <a href={externalHref} target="_blank" rel="noopener" style={cardStyle}>{inner}</a>
        ) : (
          <div style={cardStyle} aria-label={c.data.title}>{inner}</div>
        );
      })}
    </div>
  )}
</Window>
