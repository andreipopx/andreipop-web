---
import Window from './Window.astro';
import { site } from '../../config/site';
---
<Window slug="contacto" title="Contacto" x={420} y={160} width={420} height={360} z={100}>
  <div style="padding: 32px;">
    <h2 style="font-size: 32px; font-weight: 700; letter-spacing: -0.03em; margin: 0 0 12px; line-height: 1; color: var(--color-ink);">Hablemos.</h2>
    <p style="font-size: 14px; color: var(--color-muted); line-height: 1.55; margin: 0 0 24px;">
      Si te interesa colaborar, tienes una duda o quieres decir hola, aquí estoy.
    </p>
    <div style="display: flex; flex-direction: column; gap: 10px;">
      {site.social.github && (
        <a href={site.social.github} target="_blank" rel="noopener" style="display: flex; align-items: center; gap: 12px; padding: 12px 14px; border: 1px solid var(--color-border); border-radius: 10px; font-size: 14px; color: var(--color-indigo); font-weight: 500;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.95 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02.8-.22 1.65-.33 2.5-.33s1.7.11 2.5.33c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.85-2.34 4.7-4.57 4.94.36.31.68.91.68 1.85V21c0 .26.18.58.69.48A10 10 0 0 0 12 2z"/></svg>
          github ↗
        </a>
      )}
      {site.social.linkedin && site.social.linkedin !== '#' && (
        <a href={site.social.linkedin} target="_blank" rel="noopener" style="display: flex; align-items: center; gap: 12px; padding: 12px 14px; border: 1px solid var(--color-border); border-radius: 10px; font-size: 14px; color: var(--color-indigo); font-weight: 500;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.03-1.85-3.03-1.85 0-2.13 1.44-2.13 2.94v5.66H9.35V9h3.41v1.56h.05a3.74 3.74 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zm-1.78 13.02h3.56V9H3.56v11.45z"/></svg>
          linkedin ↗
        </a>
      )}
      {site.social.email ? (
        <a href={`mailto:${site.social.email}`} style="display: flex; align-items: center; gap: 12px; padding: 12px 14px; border: 1px solid var(--color-border); border-radius: 10px; font-size: 14px; color: var(--color-indigo); font-weight: 500;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 6l-10 7L2 6"/></svg>
          {site.social.email}
        </a>
      ) : (
        <div style="padding: 12px 14px; border: 1px dashed var(--color-border); border-radius: 10px; font-size: 13px; color: var(--color-muted); text-align: center;">
          correo del dominio · próximamente
        </div>
      )}
    </div>
  </div>
</Window>
