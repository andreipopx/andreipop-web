---
/**
 * Grain overlay — noise SVG que da sensación de "papel" al fondo.
 * Se aplica fixed sobre toda la ventana con mix-blend-multiply.
 * Regla anti-slop: sutil (opacity 0.5, alpha 0.08). Si se nota, es demasiado.
 */
---
<svg
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 z-[2] h-full w-full opacity-50 mix-blend-multiply"
  preserveAspectRatio="none"
>
  <filter id="grain">
    <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" seed="7" />
    <feColorMatrix values="0 0 0 0 0.05  0 0 0 0 0.06  0 0 0 0 0.08  0 0 0 0.08 0" />
  </filter>
  <rect width="100%" height="100%" filter="url(#grain)" />
</svg>
