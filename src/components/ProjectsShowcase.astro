---
import ProjectCard from './ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('proyectos'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

/**
 * En el mockup era un carrusel; para el arranque, mientras haya <= 3 proyectos,
 * mostramos una grid simple. Cuando superemos 3, activamos scroll horizontal
 * con controles (autoplay + swipe) — lo montaremos con Motion.
 */
---
{projects.length > 0 && (
  <section class="mx-auto flex max-w-[1200px] flex-col gap-6 px-8 py-16 md:px-[72px] md:py-24">
    <div class="flex items-baseline justify-between">
      <h2 class="display-section text-[32px]">En lo que ando</h2>
      <a href="/proyectos/" class="text-sm text-muted transition-colors hover:text-ink">ver todos →</a>
    </div>
    <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
      {projects.slice(0, 3).map((p) => (
        <ProjectCard
          title={p.data.title}
          tagline={p.data.tagline}
          initial={p.data.initial}
          accent={p.data.accent}
          href={p.data.url}
        />
      ))}
    </div>
  </section>
)}
