---
import { site } from '../config/site';
const year = new Date().getFullYear();
---
<footer class="mx-auto grid max-w-[1200px] grid-cols-1 gap-10 border-t border-border px-8 pt-10 pb-16 md:grid-cols-2 md:px-[72px]">
  <div class="flex flex-col gap-3">
    <h2 class="display-hero text-[40px]">Hablemos.</h2>
    <p class="max-w-[380px] text-[15px] leading-normal text-muted">
      Si te interesa colaborar, tienes una duda o quieres decir hola, escríbeme por LinkedIn o Github.
      {!site.social.email && ' Pronto también por correo del dominio.'}
    </p>
  </div>
  <div class="flex flex-col items-start justify-between gap-5 md:items-end">
    <div class="flex gap-5 text-sm">
      {site.social.github && <a href={site.social.github} class="link-indigo">github ↗</a>}
      {site.social.linkedin && site.social.linkedin !== '#' && <a href={site.social.linkedin} class="link-indigo">linkedin ↗</a>}
      {site.social.email && <a href={`mailto:${site.social.email}`} class="link-indigo">correo ↗</a>}
      <a href={site.social.rss} class="text-muted">rss</a>
    </div>
    <div class="text-xs tabular-nums text-muted">© {year}</div>
  </div>
</footer>
