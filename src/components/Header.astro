---
import { site } from '../config/site';
---
<header class="relative z-[3] mx-auto flex max-w-[1200px] items-center justify-between px-8 pt-10 pb-4 md:px-[72px]">
  <a href="/" class="text-base font-semibold tracking-tight-2">{site.name}</a>
  <nav class="hidden gap-7 text-sm text-muted md:flex">
    {site.nav.map((item) => (
      <a href={item.href} class="transition-colors hover:text-ink">{item.label}</a>
    ))}
  </nav>
</header>
