---
import { site } from '../config/site';
---
<header class="relative z-[3] mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-x-8 gap-y-3 px-8 pt-10 pb-4 md:px-[72px]">
  <a href="/" class="shrink-0 text-base font-semibold tracking-tight-2">{site.name}</a>
  <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted">
    {site.nav.map((item) => (
      <a href={item.href} class="transition-colors hover:text-ink">{item.label}</a>
    ))}
  </nav>
</header>
