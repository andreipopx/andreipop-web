---
import { site } from '../config/site';
export interface Props { slug: string; }
const { slug } = Astro.props;
---
<section class="comentarios" data-comentarios data-slug={slug} data-api={site.api.baseUrl} data-sitekey={site.api.turnstileSiteKey}>
  <div class="cap">Comentarios · <span data-cm-count>—</span></div>

  <form data-cm-form class="cm-form">
    <input type="text" name="nombre" placeholder="Tu nombre" required maxlength="60" />
    <textarea name="mensaje" placeholder="Escribe algo (máx 800 caracteres)" required maxlength="800" rows="3"></textarea>
    <div class="cm-turnstile" data-turnstile-container></div>
    <div class="cm-status" data-turnstile-status></div>
    <div class="cm-actions">
      <button type="submit" data-cm-submit>Comentar</button>
      <span class="cm-msg" data-cm-msg></span>
    </div>
  </form>

  <div data-cm-list class="cm-list">
    <div class="cm-empty">Cargando…</div>
  </div>
</section>

<style>
  .comentarios { margin: 48px 0 0; }
  .cap {
    font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--color-muted); font-weight: 500; margin-bottom: 16px;
  }
  .cm-form { display: flex; flex-direction: column; gap: 10px; margin-bottom: 32px; }
  .cm-form input, .cm-form textarea {
    padding: 10px 12px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: transparent;
    color: var(--color-ink);
    font-family: inherit; font-size: 14px;
    outline: none;
    transition: border-color 0.15s ease-out;
  }
  .cm-form input:focus, .cm-form textarea:focus { border-color: var(--color-indigo); }
  .cm-form textarea { resize: vertical; min-height: 68px; }
  .cm-turnstile:empty { display: none; }
  .cm-turnstile { display: flex; justify-content: center; margin: 4px 0; }
  .cm-status { font-size: 11px; color: var(--color-muted); min-height: 14px; }
  .cm-actions { display: flex; align-items: center; gap: 12px; }
  .cm-actions button {
    padding: 8px 18px;
    background: var(--color-indigo); color: #fff;
    border: none; border-radius: 999px;
    font-family: inherit; font-size: 14px; font-weight: 500;
    cursor: pointer; opacity: 0.6;
    transition: opacity 0.15s ease-out, transform 0.12s ease-out;
  }
  .cm-actions button:not(:disabled) { opacity: 1; }
  .cm-actions button:not(:disabled):hover { transform: translateY(-1px); }
  .cm-msg { font-size: 12px; color: var(--color-muted); }
  .cm-list { display: flex; flex-direction: column; }
  :global(.cm-item) {
    padding: 16px 0;
    border-top: 1px solid var(--color-border);
  }
  :global(.cm-item:first-child) { border-top: none; }
  :global(.cm-head) { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-bottom: 4px; }
  :global(.cm-name) { font-size: 14px; font-weight: 600; color: var(--color-ink); }
  :global(.cm-date) { font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 10px; color: var(--color-muted); }
  :global(.cm-body) { font-size: 14px; line-height: 1.55; color: var(--color-ink); white-space: pre-wrap; }
  :global(.cm-empty) { text-align: center; color: var(--color-muted); padding: 24px; font-size: 13px; }
  :global(.cm-retry) {
    margin-top: 10px; padding: 6px 14px;
    border: 1px solid var(--color-border); border-radius: 999px;
    background: transparent; color: var(--color-ink);
    font: inherit; font-size: 12px; cursor: pointer;
  }
</style>

<script>
  import { createVerifier, verifMessage, getJson } from '../scripts/verificacion';

  type Comentario = { id: string; nombre: string; mensaje: string; date: string };

  document.querySelectorAll<HTMLElement>('[data-comentarios]').forEach((root) => {
    const API = root.dataset.api!;
    let currentSlug = root.dataset.slug || '';
    const form = root.querySelector<HTMLFormElement>('[data-cm-form]')!;
    const listEl = root.querySelector<HTMLElement>('[data-cm-list]')!;
    const countEl = root.querySelector<HTMLElement>('[data-cm-count]')!;
    const msgEl = root.querySelector<HTMLElement>('[data-cm-msg]')!;
    const submitBtn = root.querySelector<HTMLButtonElement>('[data-cm-submit]')!;
    const statusEl = root.querySelector<HTMLElement>('[data-turnstile-status]')!;
    const verifier = createVerifier(
      root.querySelector<HTMLElement>('[data-turnstile-container]')!,
      root.dataset.sitekey!,
      {
        onInteractive: () => { statusEl.textContent = 'Marca la casilla para confirmar que eres humano.'; },
        onToken: () => { statusEl.textContent = ''; },
      },
    );

    let comentarios: Comentario[] = [];

    const fmt = (iso: string) => new Date(iso).toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' }).replace('.', '');
    const escape = (s: unknown) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));

    const render = () => {
      countEl.textContent = String(comentarios.length);
      if (comentarios.length === 0) {
        listEl.innerHTML = '<div class="cm-empty">Todavía no hay comentarios. Sé el primero.</div>';
        return;
      }
      listEl.innerHTML = comentarios.map((c) => `
        <div class="cm-item">
          <div class="cm-head">
            <span class="cm-name">${escape(c.nombre)}</span>
            <span class="cm-date">${fmt(c.date)}</span>
          </div>
          <div class="cm-body">${escape(c.mensaje)}</div>
        </div>
      `).join('');
    };

    const load = async () => {
      if (!currentSlug) return;
      const slug = currentSlug;
      countEl.textContent = '—';
      listEl.innerHTML = '<div class="cm-empty">Cargando…</div>';
      try {
        const data = await getJson<{ comentarios?: Comentario[] }>(`${API}/comentarios/${encodeURIComponent(slug)}`);
        if (slug !== currentSlug) return; // el usuario ya cambió de nota
        comentarios = data.comentarios || [];
        render();
      } catch (err) {
        if (slug !== currentSlug) return;
        listEl.innerHTML = `<div class="cm-empty">No se han podido cargar los comentarios (${escape((err as Error).message)}).<br>
          <button type="button" class="cm-retry">Reintentar</button></div>`;
        listEl.querySelector('.cm-retry')?.addEventListener('click', load);
      }
    };

    // La verificación arranca cuando el usuario se pone a escribir
    form.addEventListener('focusin', () => verifier.warm(), { once: true });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentSlug) return;
      const slug = currentSlug;
      const fd = new FormData(form);
      const nombre = fd.get('nombre');
      const mensaje = fd.get('mensaje');
      submitBtn.disabled = true;
      msgEl.textContent = '';
      if (!statusEl.textContent) statusEl.textContent = 'Verificando…';

      let token: string;
      try {
        token = await verifier.getToken();
      } catch (err) {
        statusEl.textContent = '';
        msgEl.textContent = verifMessage(err);
        submitBtn.disabled = false;
        return;
      }

      statusEl.textContent = 'Enviando…';
      let r: Response, data: any;
      try {
        r = await fetch(`${API}/comentarios/${encodeURIComponent(slug)}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ nombre, mensaje, token }),
        });
        data = await r.json().catch(() => ({}));
      } catch (err) {
        console.error('[comentarios] fetch failed:', err);
        statusEl.textContent = '';
        msgEl.textContent = 'No hay conexión con el servidor. Dale otra vez en un momento.';
        verifier.consume();
        submitBtn.disabled = false;
        return;
      }
      verifier.consume();
      statusEl.textContent = '';
      submitBtn.disabled = false;

      if (!r.ok) {
        msgEl.textContent = r.status === 403
          ? 'La verificación ha caducado. Dale otra vez a Comentar.'
          : `No se pudo comentar: ${data.error || `HTTP ${r.status}`}`;
        return;
      }
      msgEl.textContent = '✓ Comentario publicado';
      form.reset();
      // Lo pintamos al momento: el KV puede tardar en devolverlo en otra lectura
      if (data.comentario && slug === currentSlug) {
        comentarios = [...comentarios.filter((c) => c.id !== data.comentario.id), data.comentario];
        render();
      }
    });

    // Recarga cuando cambia la nota abierta
    document.addEventListener('note:changed', (ev) => {
      const slug = (ev as CustomEvent).detail?.slug;
      if (!slug || slug === currentSlug) return;
      currentSlug = slug;
      root.dataset.slug = slug;
      msgEl.textContent = '';
      load();
    });

    if (currentSlug) load();
  });
</script>
