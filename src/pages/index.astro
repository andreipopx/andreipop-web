---
import Layout from '../layouts/Layout.astro';
import Wallpaper from '../components/desktop/Wallpaper.astro';
import MenuBar from '../components/desktop/MenuBar.astro';
import Dock from '../components/desktop/Dock.astro';
import WelcomeWindow from '../components/desktop/WelcomeWindow.astro';
import NotasWindow from '../components/desktop/NotasWindow.astro';
import CosasWindow from '../components/desktop/CosasWindow.astro';
import InteresesWindow from '../components/desktop/InteresesWindow.astro';
import VidaWindow from '../components/desktop/VidaWindow.astro';
import ContactoWindow from '../components/desktop/ContactoWindow.astro';
import FirmaWindow from '../components/desktop/FirmaWindow.astro';
import GaleriaWindow from '../components/desktop/GaleriaWindow.astro';
import NoteViewer from '../components/desktop/NoteViewer.astro';
---
<Layout>
  <Wallpaper />
  <MenuBar />

  <main aria-label="Escritorio">
    <WelcomeWindow />
    <NotasWindow />
    <CosasWindow />
    <InteresesWindow />
    <VidaWindow />
    <GaleriaWindow />
    <FirmaWindow />
    <ContactoWindow />
    <NoteViewer />
  </main>

  <Dock />
</Layout>

<script>
  import '../scripts/desktop';
</script>
