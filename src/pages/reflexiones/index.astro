---
import Layout from '../../layouts/Layout.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('reflexiones'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Layout title="Reflexiones">
  {posts.length === 0 ? (
    <EmptyState section="Reflexiones" />
  ) : (
    <section class="mx-auto flex max-w-[720px] flex-col gap-10 px-8 py-16 md:py-24">
      <div class="flex flex-col gap-2">
        <div class="cap">Reflexiones</div>
        <h1 class="display-hero text-[56px]">Cosas que pienso.</h1>
      </div>
      <ul class="flex flex-col">
        {posts.map((p) => (
          <li>
            <a href={`/reflexiones/${p.id}/`} class="grid grid-cols-[3px_100px_1fr_auto] items-baseline gap-6 border-t border-border py-6">
              <div class="min-h-11 rounded-[2px] bg-cat-reflexiones" style="width:3px"></div>
              <div class="text-xs tabular-nums text-muted">
                {p.data.date.toLocaleDateString('es-ES', { day: '2-digit', month: '2-digit', year: '2-digit' }).replace(/\//g, '·').toUpperCase()}
              </div>
              <div class="flex flex-col gap-1">
                <div class="text-xl font-medium text-ink tracking-tight-2">{p.data.title}</div>
                {p.data.excerpt && <div class="text-sm text-muted">{p.data.excerpt}</div>}
              </div>
              <div class="cap" style="color: var(--color-cat-reflexiones)">Leer ↗</div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Layout>
