---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('proyectos'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---
<Layout title="Proyectos">
  {projects.length === 0 ? (
    <EmptyState section="Proyectos" />
  ) : (
    <section class="mx-auto flex max-w-[1200px] flex-col gap-8 px-8 py-16 md:px-[72px] md:py-24">
      <div class="flex flex-col gap-2">
        <div class="cap">Proyectos</div>
        <h1 class="display-hero text-[56px]">En lo que ando.</h1>
      </div>
      <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
        {projects.map((p) => (
          <ProjectCard
            title={p.data.title}
            tagline={p.data.tagline}
            initial={p.data.initial}
            accent={p.data.accent}
            href={p.data.url}
          />
        ))}
      </div>
    </section>
  )}
</Layout>
